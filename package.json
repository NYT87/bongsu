{
  "name": "bongsu-monorepo",
  "private": true,
  "license": "MIT",
  "author": "NYT87 <nyt87@proton.me> (https://github.com/NYT87)",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "check-personal": "bash scripts/check-personal.sh",
    "site": "sh scripts/build-site.sh",
    "brand": "sh scripts/brand/brand.sh",
    "screenshots": "node scripts/screenshots/index.mjs",
    "test:site": "node --test scripts/docs-lib.test.mjs scripts/changelog-lib.test.mjs scripts/screenshots/seed.test.mjs scripts/screenshots/serve.test.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "check": "biome check .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepare": "lefthook install"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "better-sqlite3",
      "esbuild",
      "lefthook",
      "workerd"
    ],
    "overrides": {
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "sharp@>=0.35.0 <0.35.5": "0.35.5",
      "zod@>=4.0.0 <4.6.6": "4.6.7"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "lefthook": "2.2.2",
    "marked": "18.1.3"
  }
}
