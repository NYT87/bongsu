# Bongsu's settings for Docker (docker-compose.yml reads .env). site/docs/configuration.md explains each one; the names
# are the same as on Cloudflare. Copy to .env and fill in.

# The instance's public https:// address (passkeys and Instagram's media fetch need it)
PUBLIC_URL=https://bongsu.example.com
# For the "https" profile: Caddy gets a certificate for it (the host of PUBLIC_URL)
DOMAIN=bongsu.example.com

# "1": every step runs and notifies instead of publishing. "0" when you're ready.
DRY_RUN=1

# Long random strings (openssl rand -hex 32)
SETUP_TOKEN=
MEDIA_SIGNING_KEY=
ENCRYPTION_KEY=

# The database: the SQLite file on the bongsu-data volume, unless DATABASE_URL is set. For Postgres, the "postgres"
# profile runs one:
# POSTGRES_PASSWORD=
# DATABASE_URL=postgres://bongsu:<POSTGRES_PASSWORD>@postgres:5432/bongsu

# Where the media lives: "drive" (DRIVE_SA_JSON), or "local" (the bongsu-media volume, mounted at /media)
MEDIA_STORE=local
# DRIVE_SA_JSON=

# Web Push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional
# Publishing jobs advanced per 5-minute run (default 20; Cloudflare's free plan keeps 4)
# JOBS_PER_TICK=20
# NOTIFY_URL=https://ntfy.sh/your-topic
# COMPOSIO_CONSUMER_KEY=

# Email (optional): Resend, or SMTP; with the "mail" profile, Mailpit catches everything:
# MAILER=smtp
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# MAIL_FROM=Bongsu <bongsu@example.com>

# The published image instead of building one here (then `docker compose pull bongsu`, and `up -d` without --build).
# Branding (below) needs your own build.
# BONGSU_IMAGE=ghcr.io/nyt87/bongsu:0.2

# Branding, applied when the image is built (site/docs/configuration.md): the app name and theme colour
# BONGSU_APP_NAME=Bongsu
# BONGSU_THEME_COLOR=#131f2a
