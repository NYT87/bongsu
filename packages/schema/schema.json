        },
        "account": {
          "type": "text",
          "notNull": true
        },
        "platform": {
          "type": "text",
          "notNull": true
        },
        "media_id": {
          "type": "text",
          "notNull": true
        },
        "taken_at": {
          "type": "timestamp",
          "notNull": true
        },
        "views": {
          "type": "int"
        },
        "reach": {
          "type": "int"
        },
        "likes": {
          "type": "int"
        },
        "comments": {
          "type": "int"
        },
        "saves": {
          "type": "int"
        },
        "shares": {
          "type": "int"
        },
        "workspace_id": {
          "type": "text",
          "notNull": true,
          "default": "default"
