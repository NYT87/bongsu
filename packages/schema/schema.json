            "scheduler",
            "manual",
            "import"
          ]
        },
        "at": {
          "type": "timestamp",
          "notNull": true,
          "default": {
            "now": true
          }
        },
        "published_at": {
          "type": "timestamp"
        },
        "workspace_id": {
          "type": "text",
          "notNull": true,
          "default": "default"
        }
      },
      "indexes": [
        {
          "name": "posted_account_published",
          "columns": [
            "account",
            "published_at"
          ]
        }
      ]
