            "broken"
          ],
          "default": "ok"
        },
        "last_error": {
          "type": "text"
        },
        "last_checked_at": {
          "type": "timestamp"
        },
        "updated_at": {
          "type": "timestamp",
          "notNull": true
        },
        "updated_by": {
          "type": "text"
        }
      }
    }
  }
