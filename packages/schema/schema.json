        {
          "name": "post_metrics_ws",
          "columns": [
            "workspace_id",
            "taken_at"
          ]
        }
      ]
    },
    "account_metrics": {
      "description": "The account series: one row per sample of an account's follower count (NULL when hidden).",
      "columns": {
        "id": {
          "type": "serial",
          "primaryKey": true
        },
        "account": {
          "type": "text",
          "notNull": true,
          "description": "accounts.id"
        },
        "platform": {
          "type": "text",
          "notNull": true
        },
        "taken_at": {
          "type": "timestamp",
          "notNull": true
        },
        "followers": {
          "type": "int",
          "description": "followers (Instagram) or subscribers (YouTube, rounded by YouTube)"
        },
        "workspace_id": {
          "type": "text",
          "notNull": true,
          "default": "default"
        }
      },
      "indexes": [
        {
          "name": "account_metrics_account",
          "columns": [
            "account",
            "taken_at"
          ]
        },
        {
          "name": "account_metrics_ws",
          "columns": [
            "workspace_id",
            "taken_at"
          ]
        }
      ]
    },
    "media_store": {
      "description": "The instance's media stores, one per kind: settings, encrypted credentials, last check, the default.",
      "columns": {
        "kind": {
          "type": "id",
          "primaryKey": true,
          "values": [
            "drive",
            "s3",
            "local"
          ],
          "description": "MediaRef.store"
        },
        "is_default": {
          "type": "bool",
          "notNull": true,
          "default": 0,
          "description": "where nothing names a store"
        },
        "settings": {
          "type": "json",
          "notNull": true,
          "default": "{}",
          "description": "nothing secret: endpoint, bucket, root…"
        },
        "credentials": {
          "type": "text",
          "description": "encrypted (core/crypto.ts): the S3 keys or the Drive grant"
        },
        "status": {
          "type": "text",
          "notNull": true,
          "values": [
