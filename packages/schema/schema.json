          "name": "recovery_codes_user",
          "columns": [
            "user_id"
          ]
        }
      ]
    },
    "sessions": {
      "description": "Signed-in sessions of the app and the dashboard (the token's sha256).",
      "columns": {
        "token_hash": {
          "type": "id",
          "primaryKey": true
        },
        "created_at": {
          "type": "timestamp",
          "notNull": true,
