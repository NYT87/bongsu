{
  "about": "A synthetic week for the scenario test (scenario.test.ts): every kind of post, both Instagram providers, a Shorts comment, and the ways a post is held back. Made-up accounts, texts and ids only.",
  "timezone": "Asia/Seoul",
  "items": [
    {
      "name": "short1_monday",
      "account": "demo_travel",
      "format": "video",
      "date": "2026-10-19",
      "time": "18:00",
      "caption": "A ferry at dusk.\n\nWhere would you go next?\n\n#travel",
      "comment": "Filmed on the morning boat.",
      "media": [{ "id": "media_monday_reel_0001", "mime": "video/mp4" }],
      "approve": true,
      "expect": { "state": "done", "posted": true, "calls": "composio" }
    },
    {
      "name": "carousel1_monday",
      "account": "demo_cycling",
      "date": "2026-10-19",
      "time": "19:00",
